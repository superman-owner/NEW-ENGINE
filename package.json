{
  "name": "fxforge-new-engine",
  "productName": "FXFORGE PPO Engine",
  "description": "Institutional PPO Deep Reinforcement Learning Trading Engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --open --port 5174",
    "build": "tsc -b && vite build",
